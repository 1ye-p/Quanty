knowledge/vector/
knowledge/graph/snapshots/
knowledge/graph/exports/
knowledge/sync_state/
knowledge/quarantine/
knowledge/tmp/
# Keep the catalog DuckDB itself out of git (it's a runtime artifact)
knowledge/catalog/*.duckdb

